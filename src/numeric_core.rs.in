// `numeric` arithmetic, shared by `src/exec.rs` (included) and every
// generated crate that does any (pasted), so `jwc serve` and a `jwc build`
// binary compute the same digits.
//
// Exact, as types.md §2.2 and §12.2 say it is. Before 1.1 the interpreter
// went through an `f64` and kept six places — `12345678901234.56 + 0.01`
// answered `12345678901234.570312` — and the native backend did not do
// arithmetic at all: a `numeric` is a string there, so `1.5 + 2.25` glued
// the two together and `2.5 * 2` panicked.

/// A `numeric` from its text. Scientific notation is accepted because a
/// JSON number can arrive that way.
fn jwc_decimal_parse(s: &str) -> Option<rust_decimal::Decimal> {
    let s = s.trim();
    s.parse::<rust_decimal::Decimal>()
        .ok()
        .or_else(|| rust_decimal::Decimal::from_scientific(s).ok())
}

/// The text of a `numeric`: no trailing zeros, and never `-0`. Trailing
/// zeros were always dropped (`2.5 * 2` is `5`), and keeping that is what
/// lets a program that printed one keep printing the same thing.
fn jwc_decimal_text(d: rust_decimal::Decimal) -> String {
    if d.is_zero() {
        return "0".to_string();
    }
    d.normalize().to_string()
}

/// `+ - * /` on two `numeric`s. `None` is a fault: division by zero, or a
/// result past what the representation holds (about 7.9 × 10^28).
///
/// `+ - *` are exact. `/` is exact when the quotient terminates and carries
/// 28 significant digits when it does not — `1 / 3.0` is
/// `0.3333333333333333333333333333`, not the `0.333333` an `f64` printed.
fn jwc_decimal_op(op: char, x: rust_decimal::Decimal, y: rust_decimal::Decimal) -> Option<String> {
    let r = match op {
        '+' => x.checked_add(y)?,
        '-' => x.checked_sub(y)?,
        '*' => x.checked_mul(y)?,
        '/' => x.checked_div(y)?,
        _ => return None,
    };
    Some(jwc_decimal_text(r))
}

/// Unary `-` on a `numeric`'s text. The interpreter used to prepend a `-`,
/// so negating a negative gave `--2.5`, which nothing could read back.
fn jwc_decimal_neg(s: &str) -> Option<String> {
    Some(jwc_decimal_text(-jwc_decimal_parse(s)?))
}

#[cfg(test)]
mod jwc_decimal_tests {
    use super::*;

    fn op(o: char, a: &str, b: &str) -> Option<String> {
        jwc_decimal_op(o, jwc_decimal_parse(a)?, jwc_decimal_parse(b)?)
    }

    #[test]
    fn money_does_not_touch_a_float() {
        assert_eq!(op('+', "12345678901234.56", "0.01").as_deref(), Some("12345678901234.57"));
        assert_eq!(op('+', "0.1", "0.2").as_deref(), Some("0.3"));
        assert_eq!(op('*', "19.99", "3").as_deref(), Some("59.97"));
    }

    #[test]
    fn what_used_to_print_keeps_printing_the_same() {
        assert_eq!(op('*', "2.5", "2").as_deref(), Some("5"));
        assert_eq!(op('+', "1.5", "2.25").as_deref(), Some("3.75"));
        assert_eq!(op('-', "10.0", "0.1").as_deref(), Some("9.9"));
        assert_eq!(op('-', "0.5", "0.5").as_deref(), Some("0"));
    }

    #[test]
    fn division_is_exact_when_it_can_be() {
        assert_eq!(op('/', "10", "4").as_deref(), Some("2.5"));
        assert_eq!(op('/', "1", "3").as_deref(), Some("0.3333333333333333333333333333"));
        assert_eq!(op('/', "1", "0"), None);
    }

    #[test]
    fn negation_reads_back() {
        assert_eq!(jwc_decimal_neg("-2.5").as_deref(), Some("2.5"));
        assert_eq!(jwc_decimal_neg("2.5").as_deref(), Some("-2.5"));
        assert_eq!(jwc_decimal_neg("0").as_deref(), Some("0"));
    }

    #[test]
    fn a_json_number_in_scientific_notation_is_read() {
        assert_eq!(op('+', "1e2", "0.5").as_deref(), Some("100.5"));
    }
}
