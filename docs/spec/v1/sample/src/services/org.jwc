namespace services.org;

import app;
import db.auth;
import db.org;
import dto.org;
import mail;
import views.org;

/// The invite email body. A free function needs a declaration site
/// (names.md §6.4); it is not magic and it is not a builtin.
function invite_body(token: text) -> text {
    let base = env("APP_URL") ?? "https://app.example.com";
    return "Taklifnomani qabul qilish: " + @base + "/invites/" + @token;
}

service OrgService {
    function create(req: OrgCreate, owner_id: bigint) {
        transaction {
            let org = insert Orgs into App.org.Orgs {
                ...@req
            } as { Orgs.id, Orgs.slug, Orgs.name, Orgs.created_at };

            insert Members into App.org.Members {
                org_id     = @org.id,
                account_id = @owner_id,
                role       = MemberRole.owner
            };

            return @org;
        }
    }

    function detail(org_id: bigint) {
        return select OWM from App.org.OrgWithMembers
            where OWM.id == @org_id
            first or throw NotFound("tashkilot topilmadi");
    }

    function update(org_id: bigint, req: OrgEdit) {
        return update Orgs of App.org.Orgs
            set ...@req
            where Orgs.id == @org_id
            as { Orgs.id, Orgs.slug, Orgs.name }
            first or throw NotFound("tashkilot topilmadi");
    }

    function remove(org_id: bigint, role: MemberRole) {
        if (@role != MemberRole.owner) {
            throw Forbidden("faqat egasi o'chira oladi");
        }

        delete Orgs from App.org.Orgs
            where Orgs.id == @org_id
            as { Orgs.id }
            first or throw NotFound("tashkilot topilmadi");
    }

    function members(org_id: bigint) {
        return select M from App.org.Members
            left join App.auth.Accounts A on A.id == M.account_id as one account
            where M.org_id == @org_id
            as {
                M.account_id,
                M.role,
                M.joined_at,
                account: { id, email, display_name }
            }
            orderby M.joined_at asc;
    }

    function set_role(org_id: bigint, account_id: bigint, req: MemberEdit) {
        return update Members of App.org.Members
            set role = @req.role
            where Members.org_id == @org_id and Members.account_id == @account_id
            as { Members.org_id, Members.account_id, Members.role }
            first or throw NotFound("a'zo topilmadi");
    }

    function remove_member(org_id: bigint, account_id: bigint) {
        delete Members from App.org.Members
            where Members.org_id == @org_id and Members.account_id == @account_id
            as { Members.account_id }
            first or throw NotFound("a'zo topilmadi");
    }

    function invites(org_id: bigint) {
        return select I from App.org.Invites
            where I.org_id == @org_id and I.accepted_at == null
            as { I.id, I.email, I.role, I.expires_at, I.created_at }
            orderby I.created_at desc;
    }

    /// 32 bytes from the CSPRNG, stored as an unsalted SHA-256 so it can be
    /// looked up by equality later (builtins.md §6).
    function invite(org_id: bigint, req: InviteCreate, inviter_id: bigint) {
        let token = crypto.token(32);
        let token_hash = hash.sha256(@token);
        let expires_at = date.now() + date.days(7);

        let invite = insert Invites into App.org.Invites {
            ...@req,
            org_id     = @org_id,
            token_hash = @token_hash,
            invited_by = @inviter_id,
            expires_at = @expires_at
        } as { Invites.id, Invites.email, Invites.role, Invites.expires_at };

        let body = invite_body(@token);

        mail.send(@req.email, "Taklifnoma", @body);

        return @invite;
    }

    /// The other half of `invite`, and the reason `Invites.token_hash`
    /// carries a `unique` at all: the invitee sends the token back, the
    /// server hashes it the same deterministic way, and the row is found by
    /// **equality**. `hash.password` could not do this — it salts, so every
    /// call answers differently and no lookup could ever match
    /// (builtins.md §6).
    function accept_invite(req: InviteAccept, account_id: bigint) {
        transaction {
            let token_hash = hash.sha256(@req.token);

            let invite = select I from App.org.Invites
                where I.token_hash == @token_hash and I.accepted_at == null and I.expires_at > date.now()
                as { I.id, I.org_id, I.role }
                first or throw NotFound("taklifnoma topilmadi yoki muddati o'tgan");

            insert Members into App.org.Members {
                org_id     = @invite.org_id,
                account_id = @account_id,
                role       = @invite.role
            };

            update Invites of App.org.Invites
                set accepted_at = date.now()
                where Invites.id == @invite.id;

            return @invite;
        }
    }

    function revoke_invite(org_id: bigint, invite_id: bigint) {
        delete Invites from App.org.Invites
            where Invites.id == @invite_id and Invites.org_id == @org_id
            as { Invites.id }
            first or throw NotFound("taklifnoma topilmadi");
    }
}
