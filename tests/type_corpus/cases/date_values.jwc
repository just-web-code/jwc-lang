namespace date_values;

// `date.today()` used to be the only expression in the language that
// produced a `date`. There is no date literal, `text` and `timestamptz`
// are both unassignable to a `date` column (E0606), and `raw()` wraps its
// SQL as a subquery so it can only read — which left a table carrying
// `check (ends_on > starts_on)` impossible to write a row into, because
// the two columns need two different dates and only one was constructible.
service Dates {
    function two_different_days() {
        return insert T into App.s.Terms {
            name      = "1-chorak",
            starts_on = date("2026-09-01"),
            ends_on   = date("2026-10-31")
        } as { T.id, T.starts_on, T.ends_on };
    }

    // `date + interval` is a `timestamptz` (types.md §12.1), so the
    // comparison has to be made on the wider side — `date.today()` against
    // it is E0376.
    function past_the_grace_window(id: bigint) -> boolean {
        let t = select T from App.s.Terms
            where T.id == @id
            as { T.id, T.ends_on }
            first or throw NotFound("yo'q");

        let deadline = @t.ends_on + date.days(14);
        let now = date.now();

        return @now > @deadline;
    }

    function a_date_and_a_timestamp_do_not_order(id: bigint) -> boolean {
        let t = select T from App.s.Terms
            where T.id == @id
            as { T.id, T.ends_on }
            first or throw NotFound("yo'q");

        let today = date.today();

        return @today > @t.ends_on + date.days(14);   // expect: E0376
    }
}
