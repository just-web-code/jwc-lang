# Copy to `.env`. `DATABASE_URL` and `PORT` are read by the runtime;
# `JWC_*` variables are read by the runtime through its own registry.
DATABASE_URL=postgres://postgres@localhost/{{name}}
PORT=8080
JWC_DB_POOL_SIZE=20
# Signs the session tokens. Any long random string; rotating it logs
# everyone out, which is the point.
JWT_SECRET=change-me
JWT_TTL_MINUTES=60
