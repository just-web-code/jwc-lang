# Copy to `.env`. `DATABASE_URL`, `PORT` and the `JWC_*` keys are read by
# the runtime through its own `JWC_*` registry.
DATABASE_URL=postgres://postgres@localhost/{{name}}
PORT=8080
JWC_DB_POOL_SIZE=20
# Worker tasks per process, and how often they poll an empty queue.
JWC_JOB_WORKERS=2
JWC_JOB_POLL_MS=1000
