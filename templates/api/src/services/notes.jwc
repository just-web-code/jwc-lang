namespace services.notes;

import app;
import db.notes;
import dto.notes;

service NoteService {
    /// Keyset pagination. The order has to be total — `created_at desc,
    /// id desc` — and `index on (created_at, id)` in db/notes.jwc is what
    /// keeps it off a sequential scan. The answer is
    /// `{ items, next, has_more }`; feed `next` back as `?cursor=`.
    function list(cursor: text?, size: int) {
        return select N from App.notes.Notes
            where N.archived == false
            as { N.id, N.title, N.body, N.created_at }
            orderby N.created_at desc, N.id desc
            page after @cursor size @size max 100;
    }

    function get(id: bigint) {
        return select N from App.notes.Notes
            where N.id == @id
            as { N.id, N.title, N.body, N.archived, N.created_at, N.updated_at }
            first or throw NotFound("bunday eslatma yo'q");
    }

    function create(req: NoteCreate) {
        return insert Notes into App.notes.Notes {
            ...@req
        } as { Notes.id, Notes.title, Notes.body, Notes.created_at };
    }

    function edit(id: bigint, req: NoteEdit) {
        return update Notes of App.notes.Notes
            set ...@req, updated_at = date.now()
            where Notes.id == @id
            as { Notes.id, Notes.title, Notes.body, Notes.archived, Notes.updated_at }
            first or throw NotFound("bunday eslatma yo'q");
    }

    function remove(id: bigint) {
        delete Notes from App.notes.Notes
            where Notes.id == @id;
    }
}
